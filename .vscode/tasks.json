{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Jekyll server",
            "type": "shell",
            "command": "touch index.html && bundle exec jekyll serve --incremental --livereload --baseurl='' ",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "POST: stage",
            "type": "shell",
            "command": "_scripts/new-post.sh",
            "group": {
                "kind": "none",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "POST: template",
            "type": "process",
            "command": "python",
            "args": [
                "-c",
                "${workspaceFolder}/_scripts/generate.py",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "none",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Stage and generate",
            "dependsOn": [
                "POST: stage",
                "POST: generate"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "none",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Optimize PNG files recently modified",
            "type": "shell",
            "command": "optipng $(find assets/images -type f -iname \\*.png -mtime -1)",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "BUNDLE: ALL",
            "dependsOn": [
                "BUNDLE: update",
                "BUNDLE: stage",
                "BUNDLE: commit"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "BUNDLE: update",
            "type": "process",
            "command": "bundle",
            "args": [
                "update",
                "--all"
            ],
            "problemMatcher": []
        },
        {
            "label": "BUNDLE: stage",
            "type": "process",
            "command": "git",
            "args": [
                "add",
                "Gemfile.lock"
            ],
            "problemMatcher": []
        },
        {
            "label": "BUNDLE: commit",
            "type": "process",
            "command": "git",
            "args": [
                "commit",
                "-m",
                "Gemfile.lock: update vendored gems"
            ],
            "problemMatcher": []
        },
        {
            "label": "Check how many days",
            "type": "process",
            "command": "python",
            "args": [
                "-c",
                "from datetime import date; print((date.today() - date(2020, 4, 27)).days + 1)"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}
